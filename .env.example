# Garmin credentials. Keep this file local and do not commit your real secrets.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=replace-me

# Token store path used by python-garminconnect / garth.
GARMIN_TOKENSTORE=.secrets/garmin_tokens

# Local data and metadata paths.
GARMIN_DATA_DIR=data
GARMIN_SQLITE_PATH=data/state/garmin_coach.db

# Runtime configuration.
GARMIN_REGION=global
GARMIN_LOG_LEVEL=INFO
GARMIN_RETRIES=3
GARMIN_RETRY_BACKOFF_SECONDS=1.5
